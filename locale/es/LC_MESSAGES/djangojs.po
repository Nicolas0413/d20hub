#: static/js/scripts.js:10
msgid "Fichas: %(contador)s/15"
msgstr "Fichas: %(contador)s/15"

#: static/js/scripts.js:18
msgid "Olá %(usuario)s, Seja bem-vindo ao D20HUB."
msgstr "Hola %(usuario)s, ¡bienvenido a D20HUB!"

#: static/js/scripts.js:76
msgid "Nome da ficha"
msgstr "Nombre de la ficha"

#: static/js/scripts.js:97 static/js/scripts.js:152 static/js/scripts.js:231
#: static/js/scripts.js:258
msgid "Erro"
msgstr "Error"

#: static/js/scripts.js:98
msgid "Erro ao salvar o nome da ficha! Tente novamente."
msgstr "¡Error al guardar el nombre de la ficha! Inténtalo de nuevo."

#: static/js/scripts.js:109
msgid "Acessar"
msgstr "Acceder"

#: static/js/scripts.js:119
msgid "Nome inválido"
msgstr "Nombre no válido"

#: static/js/scripts.js:120
msgid "Por favor, digite um nome para a ficha."
msgstr "Por favor, introduce un nombre para la ficha."

#: static/js/scripts.js:126
msgid "Excluir"
msgstr "Eliminar"

#: static/js/scripts.js:133
msgid "Excluir ficha"
msgstr "Eliminar ficha"

#: static/js/scripts.js:134
msgid "Tem certeza que deseja excluir esta ficha?"
msgstr "¿Estás seguro de que deseas eliminar esta ficha?"

#: static/js/scripts.js:153
msgid "Erro ao excluir ficha! Tente novamente."
msgstr "¡Error al eliminar la ficha! Inténtalo de nuevo."

#: static/js/scripts.js:187
msgid "Limite atingido"
msgstr "Límite alcanzado"

#: static/js/scripts.js:188
msgid "Você já possui o número máximo de 15 fichas."
msgstr "Ya tienes el número máximo de 15 fichas."

#: static/js/scripts.js:214
msgid "Limpar fichas"
msgstr "Eliminar todas las fichas"

#: static/js/scripts.js:215
msgid "Tem certeza que deseja excluir todas as suas fichas?"
msgstr "¿Estás seguro de que deseas eliminar todas tus fichas?"

#: static/js/scripts.js:232
msgid "Não foi possível limpar as fichas. Tente novamente."
msgstr "No se pudieron eliminar las fichas. Inténtalo de nuevo."

#: static/js/scripts.js:259
msgid "Não foi possível criar a ficha. Tente novamente."
msgstr "No se pudo crear la ficha. Inténtalo de nuevo."
